{
  "name": "@leolisen/desktop",
  "version": "0.1.0",
  "description": "Leolisen YouTube Music Desktop Player",
  "author": "Leo Blooz <bloozbits@gmail.com>",
  "private": true,
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "electron:build:win": "electron-builder --win --config electron-builder.json",
    "electron:build:mac": "electron-builder --mac --config electron-builder.json",
    "electron:build:linux": "electron-builder --linux --config electron-builder.json",
    "electron:build:all": "electron-builder -wml --config electron-builder.json",
    "pack": "npm run build && electron-builder --config electron-builder.json"
  },
  "dependencies": {
    "@leolisen/core": "file:../../packages/core",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "34.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
